# Copy to demo/.env and replace every CHANGE_ME value.
# demo/.env is gitignored.

# Host ports for this demo container. If 8080 or 55554 is already in use,
# pick free ports here and use the same numbers in SOLACE_SEMP_URL and SOLACE_HOST.
SOLACE_SEMP_PORT=8080
SOLACE_SMF_PORT=55554
SOLACE_HOST=tcp://127.0.0.1:55554
SOLACE_VPN=default
SOLACE_SEMP_URL=http://127.0.0.1:8080
SOLACE_ADMIN_USER=admin
SOLACE_ADMIN_PASSWORD=CHANGE_ME_local_admin
SOLACE_PUBLISHER_USERNAME=ssa-publisher
SOLACE_PUBLISHER_PASSWORD=CHANGE_ME_publisher
# Optional SMF client name for the publisher session. When unset, the API
# auto-generates a name (hostname/pid/counter). Two publisher connections
# with the same name will disconnect each other.
# SOLACE_CLIENT_NAME=<publisher-client-name>
SOLACE_SUBSCRIBER_USERNAME=ssa-subscriber
SOLACE_SUBSCRIBER_PASSWORD=CHANGE_ME_subscriber

# Web pages. Defaults are 127.0.0.1 and 8877.
# SOLACE_WEB_HOST=127.0.0.1
# SOLACE_WEB_PORT=8877
# SOLACE_WEB_ROLE=all

# Set to 1 only if you intend the commands to use a non-loopback broker.
# SOLACE_ALLOW_REMOTE=

# Optional two-broker path. Off unless set to 1. See SPLIT-CLIENT.md.
# Keep real hosts and passwords in a private env file, not in a committed file.
# SOLACE_SPLIT_CLIENT=
# SOLACE_PUBLISHER_HOST=
# SOLACE_PUBLISHER_VPN=
# SOLACE_PUBLISHER_USERNAME=
# SOLACE_PUBLISHER_PASSWORD=
# SOLACE_PUBLISHER_TRUST_STORE=
# SOLACE_OPERATOR_HOST=
# SOLACE_OPERATOR_VPN=
# SOLACE_OPERATOR_USERNAME=
# SOLACE_OPERATOR_PASSWORD=
# SOLACE_OPERATOR_AUTH=
# SOLACE_OPERATOR_QUEUE=
# SOLACE_GUARANTEED_TOPIC_PREFIX=

# Optional restricted-client permissions section. Off unless set to 1. See PERMISSIONS-DEMO.md.
# SOLACE_PERMISSIONS_DEMO=

# Optional simulated weather. Off unless set to 1. See MQTT-WEATHER.md.
# SOLACE_MQTT_WEATHER=
# SOLACE_MQTT_URL=
# SOLACE_MQTT_USERNAME=
# SOLACE_MQTT_PASSWORD=
# SOLACE_MQTT_TRUST_FILE=
# SOLACE_MQTT_AUTH=
# SOLACE_OPERATOR_SEMP_URL=
# SOLACE_OPERATOR_SEMP_USERNAME=
# SOLACE_OPERATOR_SEMP_PASSWORD=
